# At least one API key is required.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider ("gemini" or "openai"). Defaults to gemini when its key exists.
IMAGE_PROVIDER=

# Optional model overrides.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional: where generated images are written. Defaults to <cwd>/out.
OUT_DIR=

# Optional transport settings (CLI flags take precedence).
MCP_TRANSPORT=stdio
MCP_PORT=8000
